# --- secrets: never commit these ---
# The bearer token is supplied via SANDBOX_TOKEN at runtime, never in a file.
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# --- local notes (kept out of the public repo on purpose) ---
CLAUDE.md

# --- Go build output ---
/server
*.test
*.out
coverage.*

# --- frontend (matches at any depth, e.g. web/node_modules) ---
node_modules/
# Exclude dist *contents*, not the directory itself: git will not descend into
# an excluded directory, so the .gitkeep could never be re-included. The
# placeholder keeps //go:embed all:dist compiling on a fresh clone.
/web/dist/*
!/web/dist/.gitkeep
.vite/
*.tsbuildinfo

# --- logs / scratch ---
*.log
tmp/
.scratch/

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/
*.swp
